{
    "name": "diet-app",
    "private": true,
    "version": "0.1.0",
    "description": "Diet Management System monorepo (NestJS + Next.js + React Native + PostgreSQL) with Clean Architecture",
    "scripts": {
        "build": "pnpm -r run build",
        "dev:web": "pnpm --filter @diet/web dev",
        "dev:api": "pnpm --filter @diet/api start:dev",
        "dev:mobile": "pnpm --filter @diet/mobile start",
        "lint": "pnpm -r run lint",
        "test": "jest",
        "test:apps": "pnpm --filter @diet/api test && pnpm --filter @diet/web test && pnpm --filter @diet/mobile test",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
        "prisma:seed": "ts-node prisma/seed.ts"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/cache-manager": "3.0.1",
        "@nestjs/common": "11.1.9",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "11.1.9",
        "@nestjs/cqrs": "11.0.3",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "11.1.9",
        "@nestjs/swagger": "7.4.2",
        "@nestjs/throttler": "^6.5.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.55.0",
        "@opentelemetry/core": "^1.28.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
        "@opentelemetry/instrumentation-express": "^0.47.0",
        "@opentelemetry/instrumentation-http": "^0.57.1",
        "@opentelemetry/instrumentation-nestjs-core": "^0.44.0",
        "@opentelemetry/instrumentation-pg": "^0.51.0",
        "@opentelemetry/resources": "^2.2.0",
        "@opentelemetry/sdk-trace-base": "^2.2.0",
        "@opentelemetry/sdk-trace-node": "^1.28.0",
        "@opentelemetry/semantic-conventions": "^1.38.0",
        "@prisma/adapter-pg": "7.1.0",
        "@prisma/client": "^7.1.0",
        "@prisma/instrumentation": "^7.2.0",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "cache-manager": "^7.2.5",
        "cache-manager-redis-store": "^3.0.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "17.2.3",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.3.7",
        "jsonwebtoken": "^9.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "8.16.3",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "@faker-js/faker": "10.1.0",
        "@nestjs/testing": "^11.1.9",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.11.15",
        "@types/supertest": "6.0.3",
        "jest": "^30.2.0",
        "prisma": "^7.1.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.3"
    }
}