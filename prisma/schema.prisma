generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  appointments Appointment[] @relation("DietitianAppointments")
  auditLogs    AuditLog[]
  clients      Client[]      @relation("DietitianClients")
  dietPlans    DietPlan[]    @relation("DietitianPlans")
  reports      Report[]      @relation("UserReports")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@index([isActive, createdAt])
  @@index([deletedAt, isActive])
  @@map("users")
}

model Client {
  id           String          @id @default(cuid())
  firstName    String
  lastName     String
  email        String          @unique
  phone        String?
  dateOfBirth  DateTime?
  gender       Gender?
  dietitianId  String
  allergies    String?
  conditions   String?
  medications  String?
  notes        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  appointments Appointment[]
  metrics      ClientMetrics[]
  dietitian    User            @relation("DietitianClients", fields: [dietitianId], references: [id], onDelete: Cascade)
  dietPlans    DietPlan[]
  reports      Report[]

  @@index([dietitianId])
  @@index([email])
  @@index([isActive])
  @@index([dietitianId, isActive])
  @@index([dietitianId, createdAt])
  @@index([isActive, deletedAt])
  @@index([dietitianId, isActive, lastName])
  @@map("clients")
}

model ClientMetrics {
  id         String   @id @default(cuid())
  clientId   String
  weight     Float
  height     Float
  bmi        Float?
  bodyFat    Float?
  waist      Float?
  hip        Float?
  recordedAt DateTime @default(now())
  notes      String?
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([recordedAt])
  @@index([clientId, recordedAt(sort: Desc)])
  @@map("client_metrics")
}

model DietPlan {
  id             String         @id @default(cuid())
  name           String
  description    String?
  clientId       String
  dietitianId    String
  startDate      DateTime
  endDate        DateTime?
  status         DietPlanStatus @default(DRAFT)
  targetCalories Int?
  targetProtein  Float?
  targetCarbs    Float?
  targetFat      Float?
  targetFiber    Float?
  version        Int            @default(1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian      User           @relation("DietitianPlans", fields: [dietitianId], references: [id], onDelete: Cascade)
  mealPlans      MealPlan[]

  @@index([clientId])
  @@index([dietitianId])
  @@index([status])
  @@index([isActive])
  @@index([dietitianId, status, isActive])
  @@index([clientId, status, isActive])
  @@index([clientId, startDate, endDate])
  @@index([status, startDate])
  @@index([isActive, deletedAt])
  @@map("diet_plans")
}

model MealPlan {
  id         String    @id @default(cuid())
  dietPlanId String
  dayOfWeek  DayOfWeek
  date       DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  dietPlan   DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  meals      Meal[]

  @@index([dietPlanId])
  @@index([dayOfWeek])
  @@map("meal_plans")
}

model Meal {
  id           String         @id @default(cuid())
  mealPlanId   String
  name         String
  timeOfDay    TimeOfDay
  description  String?
  instructions String?
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  foodItems    MealFoodItem[]
  mealPlan     MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([timeOfDay])
  @@map("meals")
}

model FoodItem {
  id              String           @id @default(cuid())
  name            String
  description     String?
  category        FoodCategory
  servingSize     Float
  servingUnit     String
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float?
  sugar           Float?
  sodium          Float?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mealFoodItems   MealFoodItem[]
  nutritionalInfo NutritionalInfo?

  @@index([category])
  @@index([name])
  @@map("food_items")
}

model MealFoodItem {
  id         String   @id @default(cuid())
  mealId     String
  foodItemId String
  quantity   Float
  notes      String?
  createdAt  DateTime @default(now())
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([mealId, foodItemId])
  @@index([mealId])
  @@index([foodItemId])
  @@map("meal_food_items")
}

model NutritionalInfo {
  id                 String   @id @default(cuid())
  foodItemId         String   @unique
  vitaminA           Float?
  vitaminC           Float?
  vitaminD           Float?
  vitaminE           Float?
  vitaminK           Float?
  vitaminB6          Float?
  vitaminB12         Float?
  folate             Float?
  calcium            Float?
  iron               Float?
  magnesium          Float?
  phosphorus         Float?
  potassium          Float?
  zinc               Float?
  saturatedFat       Float?
  transFat           Float?
  monounsaturatedFat Float?
  polyunsaturatedFat Float?
  cholesterol        Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  foodItem           FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@map("nutritional_info")
}

model Appointment {
  id          String            @id @default(cuid())
  clientId    String
  dietitianId String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian   User              @relation("DietitianAppointments", fields: [dietitianId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dietitianId])
  @@index([startTime])
  @@index([status])
  @@map("appointments")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventStore {
  id            String   @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  eventData     String
  version       Int
  metaData      String?
  timestamp     DateTime @default(now())

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([eventType])
  @@map("event_store")
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  payload       String
  status        String    @default("PENDING")
  error         String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("outbox_events")
}

enum Role {
  ADMIN
  DIETITIAN
  CLIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DietPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOfDay {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
}

enum FoodCategory {
  VEGETABLES
  FRUITS
  GRAINS
  PROTEIN
  DAIRY
  FATS_OILS
  BEVERAGES
  SNACKS
  CONDIMENTS
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum ReportType {
  NUTRITION
  PROGRESS
  MEAL_PLAN
  ACTIVITY
  CUSTOM
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

model Report {
  id        String       @id @default(cuid())
  createdBy String
  user      User         @relation("UserReports", fields: [createdBy], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type      ReportType   @default(CUSTOM)
  format    ReportFormat @default(PDF)
  title     String
  data      Json
  fileUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([createdBy])
  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}